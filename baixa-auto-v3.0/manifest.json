{
  "manifest_version": 3,
  "name": "Baixador Automático v3",
  "version": "3.1.0",
  "description": "Automatiza baixas SIGITM em lote ou individualmente, com IA opcional, regras locais e correção robusta da Certificação.",
  "icons": {
    "16": "icons/sigitm-v2-16.png",
    "32": "icons/sigitm-v2-32.png",
    "48": "icons/sigitm-v2-48.png",
    "128": "icons/sigitm-v2-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://sigitm.redecorp.br/SIGITMWeb/*",
    "https://sigitm.redecorp.br/SIGITMWeb/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/sigitm-v2-48.png",
        "assets/sigitm-v2.svg"
      ],
      "matches": [
        "http://sigitm.redecorp.br/*",
        "https://sigitm.redecorp.br/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Baixador Automático v3",
    "default_icon": {
      "16": "icons/sigitm-v2-16.png",
      "32": "icons/sigitm-v2-32.png",
      "48": "icons/sigitm-v2-48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://sigitm.redecorp.br/SIGITMWeb/*",
        "https://sigitm.redecorp.br/SIGITMWeb/*"
      ],
      "js": [
        "utils/helpers.js",
        "rules/baixa-rules.js",
        "rules/validation.js",
        "automation/navigation.js",
        "automation/batch-handler.js",
        "automation/date-handler.js",
        "automation/form-handler.js",
        "automation/baixa-handler.js",
        "ui/notifications.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
